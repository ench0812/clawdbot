{
  "$schema": "https://json.schemastore.org/tsconfig",

  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "inlineSources": false,
    // "allowJs": true,
    "preserveWatchOutput": true,
    "sourceMap": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2023", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,

    /* Resolve lit deps from ui workspace package */
    "paths": {
      "lit": ["../../../../ui/node_modules/lit"],
      "lit/*": ["../../../../ui/node_modules/lit/*"],
      "@lit/context": ["../../../../ui/node_modules/@lit/context"],
      "@lit/context/*": ["../../../../ui/node_modules/@lit/context/*"],
      "@lit-labs/signals": ["../../../../ui/node_modules/@lit-labs/signals"],
      "@lit-labs/signals/*": ["../../../../ui/node_modules/@lit-labs/signals/*"],
      "signal-utils": ["../../../../ui/node_modules/signal-utils"],
      "signal-utils/*": ["../../../../ui/node_modules/signal-utils/declarations/*.d.ts", "../../../../ui/node_modules/signal-utils/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "src/**/*.json"]
}
